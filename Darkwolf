<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>عَلّاقة | أزياء مختارة</title>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap');

    :root {
      --ink: #24231f;
      --muted: #77756f;
      --paper: #f7f6f2;
      --accent: #c45d42;
      --line: #e7e4dc;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background: var(--paper);
      color: var(--ink);
      font-family: 'Cairo', sans-serif;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: min(1160px, 90%);
      margin-inline: auto;
    }

    header {
      border-bottom: 1px solid var(--line);
      background: rgba(247, 246, 242, 0.92);
    }

    nav {
      min-height: 78px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }

    .logo {
      font-size: 1.65rem;
      font-weight: 800;
      letter-spacing: -1px;
    }

    .logo span {
      color: var(--accent);
    }

    .nav-links {
      display: flex;
      gap: 30px;
      color: var(--muted);
      font-size: 0.95rem;
    }

    .nav-links a:hover {
      color: var(--accent);
    }

    .bag {
      padding: 9px 16px;
      border: 1px solid var(--ink);
      border-radius: 999px;
      font-size: 0.9rem;
    }

    .hero {
      min-height: 440px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 50px;
      padding-block: 58px;
    }

    .eyebrow {
      color: var(--accent);
      font-size: 0.9rem;
      font-weight: 700;
    }

    h1 {
      max-width: 540px;
      margin-top: 14px;
      font-size: clamp(2.7rem, 5vw, 4.8rem);
      line-height: 1.18;
      letter-spacing: -2px;
    }

    .hero-copy p {
      max-width: 440px;
      margin-top: 18px;
      color: var(--muted);
      line-height: 2;
    }

    .shop-link {
      display: inline-block;
      margin-top: 26px;
      padding: 12px 23px;
      border-radius: 999px;
      background: var(--ink);
      color: white;
      font-weight: 700;
      transition: background 0.2s, transform 0.2s;
    }

    .shop-link:hover {
      background: var(--accent);
      transform: translateY(-2px);
    }

    .hero-photo {
      min-height: 330px;
      border-radius: 8px;
      background:
        linear-gradient(0deg, rgba(25, 24, 20, 0.15), transparent 45%),
        url("https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&w=1200&q=85")
        center 38% / cover;
    }

    .collection {
      padding-block: 36px 80px;
      overflow: hidden;
    }

    .collection-heading {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 28px;
    }

    .collection-heading h2 {
      font-size: clamp(1.8rem, 3vw, 2.5rem);
    }

    .collection-heading p {
      margin-top: 4px;
      color: var(--muted);
    }

    .scroll-hint {
      color: var(--muted);
      font-size: 0.9rem;
      white-space: nowrap;
    }

    /* شريط القطع القابل للسحب يمينًا ويسارًا */
    .rack-scroll {
      overflow-x: auto;
      overflow-y: hidden;
      padding: 10px 4px 24px;
      cursor: grab;
      scrollbar-color: #c8c3b8 transparent;
      scrollbar-width: thin;
    }

    .rack-scroll:active {
      cursor: grabbing;
    }

    .rack {
      position: relative;
      display: flex;
      align-items: flex-start;
      gap: 24px;
      width: max-content;
      min-width: 100%;
      padding: 27px 14px 0;
    }

    /* قضيب التعليق */
    .rack::before {
      position: absolute;
      top: 8px;
      right: 0;
      left: 0;
      height: 7px;
      border-radius: 8px;
      background: linear-gradient(#d4d0c7, #a9a59c);
      box-shadow: 0 5px 9px rgba(40, 35, 28, 0.13);
      content: "";
    }

    .product {
      position: relative;
      width: 220px;
      flex: 0 0 220px;
      padding-top: 18px;
    }

    /* شكل الشماعة */
    .hanger {
      position: absolute;
      z-index: 2;
      top: 0;
      right: 50%;
      width: 35px;
      height: 25px;
      transform: translateX(50%);
    }

    .hanger::before {
      position: absolute;
      top: 0;
      right: 50%;
      width: 8px;
      height: 11px;
      border: 2px solid #77736b;
      border-bottom: 0;
      border-radius: 8px 8px 0 0;
      transform: translateX(50%);
      content: "";
    }

    .hanger::after {
      position: absolute;
      top: 9px;
      right: 0;
      width: 35px;
      height: 12px;
      border-top: 2px solid #77736b;
      border-right: 2px solid #77736b;
      border-left: 2px solid #77736b;
      border-radius: 4px 4px 0 0;
      clip-path: polygon(50% 0, 100% 100%, 0 100%);
      content: "";
    }

    .garment {
      position: relative;
      display: grid;
      height: 260px;
      place-items: center;
      overflow: hidden;
      border-radius: 5px 5px 2px 2px;
      background: #e8e3d9;
    }

    .garment img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.35s;
    }

    .product:hover .garment img {
      transform: scale(1.05);
    }

    .tag {
      position: absolute;
      top: 12px;
      right: 12px;
      padding: 4px 10px;
      border-radius: 999px;
      background: white;
      font-size: 0.75rem;
      font-weight: 700;
    }

    .product-info {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      padding-top: 12px;
    }

    .product-info h3 {
      font-size: 0.98rem;
    }

    .product-info p {
      margin-top: 2px;
      color: var(--muted);
      font-size: 0.86rem;
    }

    .price {
      color: var(--accent);
      font-weight: 800;
      white-space: nowrap;
    }

    footer {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      padding-block: 22px;
      border-top: 1px solid var(--line);
      color: var(--muted);
      font-size: 0.88rem;
    }

    @media (max-width: 700px) {
      nav {
        min-height: 68px;
      }

      .nav-links {
        display: none;
      }

      .hero {
        grid-template-columns: 1fr;
        gap: 28px;
        padding-block: 38px;
      }

      .hero-photo {
        min-height: 270px;
      }

      .collection-heading {
        align-items: flex-start;
        flex-direction: column;
      }

      .product {
        width: 185px;
        flex-basis: 185px;
      }

      .garment {
        height: 235px;
      }

      footer {
        flex-direction: column;
      }
    }
  </style>
</head>

